# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-haiku-5.5
MCP_URL=https://bk-api.bankkaro.com/mcp
# off = guardrails report only (baseline); on = enforce (only after approval)
GUARDRAILS=off
# Client-side pacing of the production MCP server (limit observed: ~65 requests / 3 min).
# Every HTTP request counts; the state file is shared by the UI and the eval runner.
MCP_MAX_REQUESTS=50
MCP_WINDOW_S=180
MCP_MIN_INTERVAL_S=0.5
# MCP_RATE_STATE=.cache/mcp_ratelimit.json
CATALOG_TTL_S=600
# Per-turn limits: MCP calls per turn (extra calls refused) and a hard deadline for the whole turn
MAX_TOOL_CALLS_PER_TURN=6
TURN_DEADLINE_S=180
